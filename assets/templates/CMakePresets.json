{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base non-vcpkg preset (inherit directly when using system packages, FetchContent, or Conan).",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "base-vcpkg",
      "hidden": true,
      "description": "Base vcpkg manifest preset; requires VCPKG_ROOT to be set explicitly in the environment.",
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "windows-msvc-ninja-debug",
      "displayName": "Windows x64 MSVC + Ninja (Debug)",
      "description": "Run from an initialized x64 MSVC environment (vcvars64.bat) with VCPKG_ROOT set; change VCPKG_TARGET_TRIPLET to arm64-windows on ARM64.",
      "inherits": "base-vcpkg",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-ninja-release",
      "displayName": "Windows x64 MSVC + Ninja (Release)",
      "inherits": "windows-msvc-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 Visual Studio 2022 (Multi-Config)",
      "inherits": "base-vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux x64 GCC + Ninja (Debug)",
      "description": "x64 Linux preset; adjust VCPKG_TARGET_TRIPLET to arm64-linux on aarch64 hosts.",
      "inherits": "base-vcpkg",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux x64 GCC + Ninja (Release)",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-asan-debug",
      "displayName": "Linux x64 Clang + Ninja + ASan/UBSan (Debug)",
      "description": "ASan/UBSan preset; align vcpkg triplet compiler or set ASAN_OPTIONS=detect_container_overflow=0 if false container-overflow occurs against GCC-built vcpkg libs.",
      "inherits": "base-vcpkg",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-tsan-debug",
      "displayName": "Linux x64 Clang + Ninja + TSan (Debug)",
      "description": "TSan preset; prefer inheriting 'base' or using a custom TSan-instrumented vcpkg triplet when linking C++ third-party libraries to avoid uninstrumented false races.",
      "inherits": "base-vcpkg",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Clang + Ninja (Debug)",
      "description": "Apple Silicon preset; switch CMAKE_OSX_ARCHITECTURES to x86_64 and VCPKG_TARGET_TRIPLET to x64-osx on Intel Macs.",
      "inherits": "base-vcpkg",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Clang + Ninja (Release)",
      "inherits": "macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-ninja-debug",
      "configurePreset": "windows-msvc-ninja-debug"
    },
    {
      "name": "windows-msvc-ninja-release",
      "configurePreset": "windows-msvc-ninja-release"
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "linux-clang-asan-debug",
      "configurePreset": "linux-clang-asan-debug"
    },
    {
      "name": "linux-clang-tsan-debug",
      "configurePreset": "linux-clang-tsan-debug"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-ninja-debug",
      "configurePreset": "windows-msvc-ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-ninja-release",
      "configurePreset": "windows-msvc-ninja-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-asan-debug",
      "configurePreset": "linux-clang-asan-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-tsan-debug",
      "configurePreset": "linux-clang-tsan-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
